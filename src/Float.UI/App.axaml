<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Float.UI.App"
             xmlns:local="using:Float.UI"
             RequestedThemeVariant="Default"
             Name="Float">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Float.UI/Resources/Icons.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Float.UI/Resources/FloatStyles.axaml"/>
    </Application.Styles>

    <!-- macOS app menu (Float) — only app-level items go here -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="Float">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="About Float"  Click="OnAboutClick"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Preferences…" Click="OnSettingsClick" Gesture="Ctrl+OemComma"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Quit Float"   Click="OnQuitClick"     Gesture="Ctrl+Q"/>
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <!-- System tray icon -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/float_tray_dark.png"
                      ToolTipText="Float"
                      Clicked="OnTrayIconClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Show Float" Click="OnShowFloatClick"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Preferences…" Click="OnSettingsClick"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Quit Float" Click="OnQuitClick"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

</Application>
