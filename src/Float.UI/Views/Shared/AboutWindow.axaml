<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="using:Float.UI.Views.Shared"
        xmlns:resx="using:Float.UI.Resources"
        x:Class="Float.UI.Views.Shared.AboutWindow"
        x:DataType="shared:AboutWindow"
        Title="About Float"
        Width="320"
        Height="300"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FloatCardBackgroundBrush}"
        ExtendClientAreaToDecorationsHint="False">

    <Border Padding="24">
        <Grid RowDefinitions="*,Auto">
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                <Border Width="84"
                        Height="84"
                        CornerRadius="20"
                        ClipToBounds="True"
                        HorizontalAlignment="Center">
                    <Image Source="/Assets/float_icon.png"
                           Stretch="UniformToFill"/>
                </Border>
                <TextBlock Text="Float"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding VersionText}"
                           FontSize="13"
                           Foreground="{DynamicResource FloatSecondaryTextBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <Button Grid.Row="1"
                    Theme="{StaticResource PrimaryButtonTheme}"
                    Content="{x:Static resx:UiStrings.Close}"
                    Click="OnClose"
                    HorizontalAlignment="Right"
                    Padding="16,6"
                    FontSize="12"/>
        </Grid>
    </Border>
</Window>
