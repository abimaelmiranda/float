<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Float.UI.ViewModels"
             x:Class="Float.UI.Views.Shared.InlineErrorBanner"
             x:DataType="vm:IHasError">

    <Border IsVisible="{Binding HasError}"
            Padding="10"
            CornerRadius="6"
            Background="{DynamicResource FloatCardBackgroundBrush}"
            BorderBrush="{DynamicResource StatusErrorBrush}"
            BorderThickness="1">
        <TextBlock Text="{Binding ErrorMessage}"
                   FontSize="12"
                   Foreground="{DynamicResource StatusErrorBrush}"
                   TextWrapping="Wrap"/>
    </Border>

</UserControl>
