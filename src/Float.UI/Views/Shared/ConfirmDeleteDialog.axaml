<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Float.UI.ViewModels"
             xmlns:resx="using:Float.UI.Resources"
             x:Class="Float.UI.Views.Shared.ConfirmDeleteDialog"
             x:DataType="vm:IHasPendingDelete"
             x:Name="Self">

    <Border Background="#99000000"
            IsVisible="{Binding HasPendingDelete}">
        <Border Width="380"
                Padding="18"
                CornerRadius="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource FloatCardBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="1">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding #Self.Title}"
                           FontSize="15"
                           FontWeight="SemiBold"/>
                <TextBlock FontSize="13"
                           TextWrapping="Wrap">
                    <Run Text="{x:Static resx:UiStrings.DeletePromptPrefix}"/>
                    <Run Text="{Binding PendingDeleteName}" FontWeight="SemiBold"/>?
                    <Run Text="{x:Static resx:UiStrings.DeletePromptSuffix}"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right">
                    <Button Theme="{StaticResource ActionButtonTheme}"
                            Content="{x:Static resx:UiStrings.Cancel}"
                            Command="{Binding CancelDeleteCommand}"/>
                    <Button Theme="{StaticResource DangerButtonTheme}"
                            Content="{x:Static resx:UiStrings.Delete}"
                            Command="{Binding ConfirmDeleteCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>

</UserControl>
