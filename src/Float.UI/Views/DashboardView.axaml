<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Float.UI.ViewModels"
             x:Class="Float.UI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Grid ColumnDefinitions="*,Auto">

        <!-- ── Left: container list ──────────────────────────────────── -->
        <DockPanel Grid.Column="0">

            <!-- Header bar -->
            <Border DockPanel.Dock="Top"
                    Padding="20,52,20,12">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Containers"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Theme="{StaticResource PrimaryButtonTheme}"
                                Command="{Binding NewContainerCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="icon icon-sm"
                                      Data="{StaticResource IconNewContainer}"
                                      Stroke="{Binding $parent[Button].Foreground}"/>
                                <TextBlock Text="New Container" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border IsVisible="{Binding HasError}"
                            Padding="10"
                            CornerRadius="6"
                            Background="{DynamicResource FloatCardBackgroundBrush}"
                            BorderBrush="{DynamicResource StatusErrorBrush}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource StatusErrorBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- List -->
            <ScrollViewer Padding="16,0,16,16">
                <ListBox Classes="container-list"
                         ItemsSource="{Binding Containers}"
                         SelectedItem="{Binding SelectedContainer}">

                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ContainerItemViewModel">

                            <!-- Container row card -->
                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                    CornerRadius="8"
                                    Padding="14,10"
                                    Classes.selected="{Binding $parent[ListBoxItem].IsSelected}">

                                <Border.Styles>
                                    <Style Selector="Border.selected">
                                        <Setter Property="Background"
                                                Value="{DynamicResource SystemControlHighlightListAccentLowBrush}"/>
                                    </Style>
                                    <Style Selector="Border:pointerover">
                                        <Setter Property="Background"
                                                Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
                                    </Style>
                                </Border.Styles>

                                <Grid ColumnDefinitions="16,*,Auto,Auto">

                                    <!-- Status dot -->
                                    <Ellipse Grid.Column="0"
                                             Classes="status-dot"
                                             Classes.running="{Binding IsRunning}"
                                             VerticalAlignment="Center"/>

                                    <!-- Name + image tag -->
                                    <StackPanel Grid.Column="1"
                                                Spacing="1"
                                                Margin="10,0,16,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="Medium"/>
                                        <TextBlock Text="{Binding ImageTag}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    </StackPanel>

                                    <!-- Port summary -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding PortSummary}"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,20,0"/>

                                    <!-- Action buttons -->
                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                Spacing="2"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="6"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsBusy}">
                                            <ProgressBar Width="34"
                                                         Height="4"
                                                         IsIndeterminate="True"
                                                         VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding BusyLabel}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Button Theme="{StaticResource ActionButtonTheme}"
                                                Tag="{Binding Source}"
                                                Click="OnStartContainerClick"
                                                IsEnabled="{Binding !IsBusy}"
                                                IsVisible="{Binding !IsRunning}"
                                                ToolTip.Tip="Start">
                                            <Path Classes="icon icon-sm"
                                                  Data="{StaticResource IconPlay}"
                                                  Stroke="{Binding $parent[Button].Foreground}"/>
                                        </Button>

                                        <Button Theme="{StaticResource ActionButtonTheme}"
                                                Tag="{Binding Source}"
                                                Click="OnStopContainerClick"
                                                IsEnabled="{Binding !IsBusy}"
                                                IsVisible="{Binding IsRunning}"
                                                ToolTip.Tip="Stop">
                                            <Path Classes="icon icon-sm"
                                                  Data="{StaticResource IconStop}"
                                                  Stroke="{Binding $parent[Button].Foreground}"/>
                                        </Button>

                                        <Button Theme="{StaticResource ActionButtonTheme}"
                                                Tag="{Binding Source}"
                                                Click="OnRestartContainerClick"
                                                IsEnabled="{Binding !IsBusy}"
                                                ToolTip.Tip="Restart">
                                            <Path Classes="icon icon-sm"
                                                  Data="{StaticResource IconRestart}"
                                                  Stroke="{Binding $parent[Button].Foreground}"/>
                                        </Button>

                                        <Button Theme="{StaticResource DangerButtonTheme}"
                                                Tag="{Binding Source}"
                                                Click="OnRequestDeleteClick"
                                                IsEnabled="{Binding !IsBusy}"
                                                ToolTip.Tip="Delete">
                                            <Path Classes="icon icon-sm"
                                                  Data="{StaticResource IconDelete}"
                                                  Stroke="{Binding $parent[Button].Foreground}"/>
                                        </Button>

                                    </StackPanel>

                                </Grid>
                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </ScrollViewer>
        </DockPanel>

        <!-- ── Right: detail panel ───────────────────────────────────── -->
        <Border Grid.Column="1"
                Width="300"
                IsVisible="{Binding HasSelectedContainer}"
                Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="1,0,0,0">
            <ContentControl Content="{Binding SelectedContainer}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:ContainerItemViewModel">
                        <DockPanel>

                            <!-- Detail header -->
                            <Border DockPanel.Dock="Top" Padding="16,52,16,12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Theme="{StaticResource ActionButtonTheme}"
                                            Click="OnCloseDetailClick"
                                            ToolTip.Tip="Close">
                                        <Path Classes="icon icon-sm"
                                              Data="{StaticResource IconClose}"
                                              Stroke="{Binding $parent[Button].Foreground}"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Detail body -->
                            <ScrollViewer Padding="16,0,16,16">
                                <StackPanel Spacing="20">

                                    <!-- Status -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="STATUS"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   LetterSpacing="1"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Classes="status-dot"
                                                     Classes.running="{Binding IsRunning}"/>
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding BusyLabel}"
                                                   IsVisible="{Binding IsBusy}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    </StackPanel>

                                    <!-- Image -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="IMAGE"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   LetterSpacing="1"/>
                                        <TextBlock Text="{Binding ImageTag}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Ports -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="PORTS"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   LetterSpacing="1"/>
                                        <TextBlock Text="{Binding PortSummary}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"/>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="ACTIONS"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   LetterSpacing="1"/>

                                        <Button Theme="{StaticResource ActionButtonTheme}"
                                                Content="Stop Container"
                                                Tag="{Binding Source}"
                                                Click="OnStopContainerClick"
                                                IsEnabled="{Binding !IsBusy}"
                                                IsVisible="{Binding IsRunning}"
                                                HorizontalAlignment="Left"/>

                                        <Button Theme="{StaticResource ActionButtonTheme}"
                                                Content="Start Container"
                                                Tag="{Binding Source}"
                                                Click="OnStartContainerClick"
                                                IsEnabled="{Binding !IsBusy}"
                                                IsVisible="{Binding !IsRunning}"
                                                HorizontalAlignment="Left"/>

                                        <Button Theme="{StaticResource ActionButtonTheme}"
                                                Content="Restart"
                                                Tag="{Binding Source}"
                                                Click="OnRestartContainerClick"
                                                IsEnabled="{Binding !IsBusy}"
                                                HorizontalAlignment="Left"/>

                                        <Button Theme="{StaticResource DangerButtonTheme}"
                                                Content="Delete Container"
                                                Tag="{Binding Source}"
                                                Click="OnRequestDeleteClick"
                                                IsEnabled="{Binding !IsBusy}"
                                                HorizontalAlignment="Left"/>
                                    </StackPanel>

                                </StackPanel>
                            </ScrollViewer>

                        </DockPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>

        <!-- ── Delete confirmation overlay ─────────────────────────── -->
        <Border Grid.ColumnSpan="2"
                Background="#99000000"
                IsVisible="{Binding HasPendingDelete}">
            <Border Width="380"
                    Padding="18"
                    CornerRadius="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource FloatCardBackgroundBrush}"
                    BorderBrush="{DynamicResource SidebarBorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Delete container"
                               FontSize="15"
                               FontWeight="SemiBold"/>
                    <TextBlock FontSize="13"
                               TextWrapping="Wrap">
                        Are you sure you want to delete
                        <Run Text="{Binding PendingDeleteName}" FontWeight="SemiBold"/>?
                        This action cannot be undone.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right">
                        <Button Theme="{StaticResource ActionButtonTheme}"
                                Content="Cancel"
                                Command="{Binding CancelDeleteCommand}"/>
                        <Button Theme="{StaticResource DangerButtonTheme}"
                                Content="Delete"
                                Command="{Binding ConfirmDeleteCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>

</UserControl>
