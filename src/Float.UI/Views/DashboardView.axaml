<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Float.UI.ViewModels"
             xmlns:shared="using:Float.UI.Views.Shared"
             xmlns:resx="using:Float.UI.Resources"
             x:Class="Float.UI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Grid>

        <!-- ── Container list (shown when no detail open) ────────────── -->
        <DockPanel IsVisible="{Binding ShowList}">

            <!-- Header bar -->
            <Border DockPanel.Dock="Top"
                    Padding="20,52,20,12">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{x:Static resx:UiStrings.Containers}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Theme="{StaticResource PrimaryButtonTheme}"
                                Command="{Binding NewContainerCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="icon icon-sm"
                                      Data="{StaticResource IconNewContainer}"
                                      Stroke="{Binding $parent[Button].Foreground}"/>
                                <TextBlock Text="{x:Static resx:UiStrings.NewContainer}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <shared:InlineErrorBanner/>
                </StackPanel>
            </Border>

            <!-- List -->
            <ScrollViewer Padding="16,0,16,16">
                <ListBox Classes="container-list"
                         ItemsSource="{Binding Containers}"
                         SelectedItem="{Binding SelectedContainer}">

                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ContainerItemViewModel">

                            <!-- Container row card -->
                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                    CornerRadius="8"
                                    Padding="14,10"
                                    Classes.selected="{Binding $parent[ListBoxItem].IsSelected}">

                                <Border.Styles>
                                    <Style Selector="Border.selected">
                                        <Setter Property="Background"
                                                Value="{DynamicResource SystemControlHighlightListAccentLowBrush}"/>
                                    </Style>
                                    <Style Selector="Border:pointerover">
                                        <Setter Property="Background"
                                                Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
                                    </Style>
                                </Border.Styles>

                                <Grid ColumnDefinitions="16,*,Auto,Auto">

                                    <!-- Status dot -->
                                    <Ellipse Grid.Column="0"
                                             Classes="status-dot"
                                             Classes.running="{Binding IsRunning}"
                                             VerticalAlignment="Center"/>

                                    <!-- Name + image tag -->
                                    <StackPanel Grid.Column="1"
                                                Spacing="1"
                                                Margin="10,0,16,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="Medium"/>
                                        <TextBlock Text="{Binding ImageTag}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    </StackPanel>

                                    <!-- Port summary -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding PortSummary}"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,20,0"/>

                                    <!-- Action buttons -->
                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                Spacing="2"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="6"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsBusy}">
                                            <ProgressBar Width="34"
                                                         Height="4"
                                                         IsIndeterminate="True"
                                                         VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding BusyLabel}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Button Theme="{StaticResource ActionButtonTheme}"
                                                Tag="{Binding Source}"
                                                Click="OnStartContainerClick"
                                                IsEnabled="{Binding !IsBusy}"
                                                IsVisible="{Binding !IsRunning}"
                                                ToolTip.Tip="{x:Static resx:UiStrings.Start}">
                                            <Path Classes="icon icon-sm"
                                                  Data="{StaticResource IconPlay}"
                                                  Stroke="{Binding $parent[Button].Foreground}"/>
                                        </Button>

                                        <Button Theme="{StaticResource ActionButtonTheme}"
                                                Tag="{Binding Source}"
                                                Click="OnStopContainerClick"
                                                IsEnabled="{Binding !IsBusy}"
                                                IsVisible="{Binding IsRunning}"
                                                ToolTip.Tip="{x:Static resx:UiStrings.Stop}">
                                            <Path Classes="icon icon-sm"
                                                  Data="{StaticResource IconStop}"
                                                  Stroke="{Binding $parent[Button].Foreground}"/>
                                        </Button>

                                        <Button Theme="{StaticResource ActionButtonTheme}"
                                                Tag="{Binding Source}"
                                                Click="OnRestartContainerClick"
                                                IsEnabled="{Binding !IsBusy}"
                                                ToolTip.Tip="{x:Static resx:UiStrings.Restart}">
                                            <Path Classes="icon icon-sm"
                                                  Data="{StaticResource IconRestart}"
                                                  Stroke="{Binding $parent[Button].Foreground}"/>
                                        </Button>

                                        <Button Theme="{StaticResource DangerButtonTheme}"
                                                Tag="{Binding Source}"
                                                Click="OnRequestDeleteClick"
                                                IsEnabled="{Binding !IsBusy}"
                                                ToolTip.Tip="{x:Static resx:UiStrings.Delete}">
                                            <Path Classes="icon icon-sm"
                                                  Data="{StaticResource IconDelete}"
                                                  Stroke="{Binding $parent[Button].Foreground}"/>
                                        </Button>

                                    </StackPanel>

                                </Grid>
                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </ScrollViewer>
        </DockPanel>

        <!-- ── Container detail (shown when container selected) ──────── -->
        <ContentControl Content="{Binding Detail}" IsVisible="{Binding ShowDetail}"/>

        <!-- ── Delete confirmation overlay (spans both views) ────────── -->
        <shared:ConfirmDeleteDialog Title="{x:Static resx:UiStrings.DeleteContainerTitle}"/>

    </Grid>

</UserControl>
