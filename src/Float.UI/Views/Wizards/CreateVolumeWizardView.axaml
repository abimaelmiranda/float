<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Float.UI.ViewModels.Wizards"
             xmlns:shared="using:Float.UI.Views.Shared"
             x:Class="Float.UI.Views.Wizards.CreateVolumeWizardView"
             x:DataType="vm:CreateVolumeWizardViewModel">

    <Grid RowDefinitions="*,Auto">
        <Border Padding="24,56,24,24"
                IsVisible="{Binding IsDetailsStep}">
            <StackPanel Spacing="18" MaxWidth="520">
                <TextBlock Text="Create Volume"
                           FontSize="20"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Volumes are managed storage inside Apple Container. Use bind mounts when you need to expose a macOS folder to a container."
                           FontSize="13"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           TextWrapping="Wrap"/>

                <StackPanel Spacing="6">
                    <TextBlock Text="Volume name"
                               FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBox Text="{Binding VolumeName}"
                             PlaceholderText="my-volume"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Size"
                               FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
                        <NumericUpDown Value="{Binding VolumeSizeValue}"
                                       Minimum="1"
                                       Increment="1"
                                       PlaceholderText="Optional"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding SizeUnitOptions}"
                                  SelectedItem="{Binding VolumeSizeUnit}"/>
                    </Grid>
                    <TextBlock Text="{Binding VolumeSizeWarning}"
                               IsVisible="{Binding HasVolumeSizeWarning}"
                               FontSize="12"
                               Foreground="{DynamicResource StatusWarningBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Journaling"
                               FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <ComboBox ItemsSource="{Binding JournalModeOptions}"
                              SelectedItem="{Binding JournalMode}"/>
                </StackPanel>

                <StackPanel Spacing="6"
                            IsVisible="{Binding IsJournalSizeVisible}">
                    <TextBlock Text="Journal size"
                               FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
                        <NumericUpDown Value="{Binding JournalSizeValue}"
                                       Minimum="1"
                                       Increment="1"
                                       PlaceholderText="Optional"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding SizeUnitOptions}"
                                  SelectedItem="{Binding JournalSizeUnit}"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Padding="24,56,24,24"
                IsVisible="{Binding IsCreatingStep}">
            <StackPanel Spacing="18" MaxWidth="680">
                <TextBlock Text="Creating Volume"
                           FontSize="20"
                           FontWeight="SemiBold"/>

                <shared:InlineErrorBanner/>

                <Border IsVisible="{Binding IsComplete}"
                        Padding="10"
                        CornerRadius="6"
                        Background="{DynamicResource FloatCardBackgroundBrush}"
                        BorderBrush="{DynamicResource FloatAccentBrush}"
                        BorderThickness="1">
                    <TextBlock Text="Volume created."
                               FontSize="12"
                               Foreground="{DynamicResource FloatAccentBrush}"/>
                </Border>

                <TextBox Text="{Binding Output}"
                         x:Name="OutputBox"
                         Classes="console"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="180"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Classes="footer-bar"
                Padding="16">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <Button Theme="{StaticResource ActionButtonTheme}"
                        Command="{Binding CancelCommand}"
                        IsVisible="{Binding !IsComplete}">
                    <TextBlock Text="Cancel"/>
                </Button>

                <Button Grid.Column="2"
                        Theme="{StaticResource PrimaryButtonTheme}"
                        Command="{Binding CreateVolumeCommand}"
                        IsEnabled="{Binding CanCreate}"
                        IsVisible="{Binding IsDetailsStep}">
                    <TextBlock Text="Create"/>
                </Button>

                <Button Grid.Column="3"
                        Theme="{StaticResource PrimaryButtonTheme}"
                        Command="{Binding DoneCommand}"
                        IsVisible="{Binding IsComplete}">
                    <TextBlock Text="Done"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
