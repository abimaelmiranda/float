<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Float.UI.ViewModels"
             xmlns:resx="using:Float.UI.Resources"
             x:Class="Float.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel Spacing="0" Margin="32,32,32,32" MaxWidth="520">

            <TextBlock Text="{x:Static resx:UiStrings.Preferences}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,24"/>

            <!-- Container Defaults -->
            <TextBlock Text="{x:Static resx:UiStrings.ContainerDefaults}"
                       Classes="section-label"
                       Margin="0,0,0,10"/>

            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,20">
                <StackPanel Spacing="14">

                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,8,0">
                            <TextBlock Text="{x:Static resx:UiStrings.DefaultRegistry}" FontSize="12"
                                       Foreground="{DynamicResource FloatSecondaryTextBrush}"/>
                            <ComboBox ItemsSource="{Binding RegistryOptions}"
                                      SelectedItem="{Binding DefaultRegistry}"
                                      FontSize="13"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5" Margin="8,0,0,0">
                            <TextBlock Text="{x:Static resx:UiStrings.DefaultArchitecture}" FontSize="12"
                                       Foreground="{DynamicResource FloatSecondaryTextBrush}"/>
                            <ComboBox ItemsSource="{Binding ArchitectureOptions}"
                                      SelectedItem="{Binding DefaultArchitecture}"
                                      FontSize="13"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource SidebarBorderBrush}"/>

                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,8,0">
                            <TextBlock Text="{x:Static resx:UiStrings.DefaultCpuCores}" FontSize="12"
                                       Foreground="{DynamicResource FloatSecondaryTextBrush}"/>
                            <TextBox Text="{Binding DefaultCpuCount}"
                                     PlaceholderText="e.g. 2 (optional)"
                                     FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5" Margin="8,0,0,0">
                            <TextBlock Text="{x:Static resx:UiStrings.DefaultMemory}" FontSize="12"
                                       Foreground="{DynamicResource FloatSecondaryTextBrush}"/>
                            <TextBox Text="{Binding DefaultMemory}"
                                     PlaceholderText="e.g. 512m, 2g (optional)"
                                     FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource SidebarBorderBrush}"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Static resx:UiStrings.KeepAlive}" FontSize="13" FontWeight="Medium"/>
                            <TextBlock Text="{x:Static resx:UiStrings.KeepAliveDescription}"
                                       FontSize="11"
                                       Foreground="{DynamicResource FloatSecondaryTextBrush}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding DefaultKeepAlive}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Static resx:UiStrings.StartImmediately}" FontSize="13" FontWeight="Medium"/>
                            <TextBlock Text="{x:Static resx:UiStrings.StartImmediatelyDescription}"
                                       FontSize="11"
                                       Foreground="{DynamicResource FloatSecondaryTextBrush}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding StartImmediately}"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- Container Behavior -->
            <TextBlock Text="{x:Static resx:UiStrings.ContainerBehavior}"
                       Classes="section-label"
                       Margin="0,0,0,10"/>

            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,20">
                <StackPanel Spacing="14">

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Static resx:UiStrings.ForceDeleteRunningContainers}" FontSize="13" FontWeight="Medium"/>
                            <TextBlock Text="{x:Static resx:UiStrings.ForceDeleteRunningContainersDescription}"
                                       FontSize="11"
                                       Foreground="{DynamicResource FloatSecondaryTextBrush}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding ForceDeleteRunning}"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource SidebarBorderBrush}"/>

                    <Grid ColumnDefinitions="*,80">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Static resx:UiStrings.StopTimeoutSeconds}" FontSize="13" FontWeight="Medium"/>
                            <TextBlock Text="{x:Static resx:UiStrings.StopTimeoutSecondsDescription}"
                                       FontSize="11"
                                       Foreground="{DynamicResource FloatSecondaryTextBrush}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 Text="{Binding StopTimeoutSeconds}"
                                 FontSize="13"
                                 VerticalAlignment="Center"
                                 HorizontalContentAlignment="Center"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- Application -->
            <TextBlock Text="{x:Static resx:UiStrings.Application}"
                       Classes="section-label"
                       Margin="0,0,0,10"/>

            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,24">
                <StackPanel Spacing="14">

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Static resx:UiStrings.CloseToTray}" FontSize="13" FontWeight="Medium"/>
                            <TextBlock Text="{x:Static resx:UiStrings.CloseToTrayDescription}"
                                       FontSize="11"
                                       Foreground="{DynamicResource FloatSecondaryTextBrush}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding CloseToTray}"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource SidebarBorderBrush}"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Static resx:UiStrings.StopEngineOnQuit}" FontSize="13" FontWeight="Medium"/>
                            <TextBlock Text="{x:Static resx:UiStrings.StopEngineOnQuitDescription}"
                                       FontSize="11"
                                       Foreground="{DynamicResource FloatSecondaryTextBrush}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding StopEngineOnQuit}"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource SidebarBorderBrush}"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Static resx:UiStrings.ShowInDock}" FontSize="13" FontWeight="Medium"/>
                            <TextBlock Text="{x:Static resx:UiStrings.ShowInDockDescription}"
                                       FontSize="11"
                                       Foreground="{DynamicResource FloatSecondaryTextBrush}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding ShowInDock}"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource SidebarBorderBrush}"/>

                    <Grid ColumnDefinitions="*,180">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Static resx:UiStrings.Language}" FontSize="13" FontWeight="Medium"/>
                            <TextBlock Text="{Binding LanguageRestartMessage}"
                                       FontSize="11"
                                       Foreground="{DynamicResource FloatSecondaryTextBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding LanguageOptions}"
                                  SelectedItem="{Binding Language}"
                                  FontSize="13"
                                  VerticalAlignment="Center"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- Footer -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Theme="{StaticResource ActionButtonTheme}"
                        Content="{x:Static resx:UiStrings.Cancel}"
                        Command="{Binding CloseCommand}"
                        Padding="16,6"
                        FontSize="12"/>
                <Button Theme="{StaticResource PrimaryButtonTheme}"
                        Content="{x:Static resx:UiStrings.Save}"
                        Command="{Binding SaveCommand}"
                        Padding="16,6"
                        FontSize="12"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
