<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Float.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Float.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Float"
        Width="1100" Height="700"
        MinWidth="900" MinHeight="600"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

    <DockPanel>

        <!-- ── Sidebar (hidden in setup mode) ───────────────────────── -->
        <DockPanel DockPanel.Dock="Left"
                   Width="200"
                   IsVisible="{Binding !IsSetupMode}"
                   Background="{DynamicResource SidebarBackgroundBrush}">

            <Border DockPanel.Dock="Top"
                    Padding="16,52,16,8"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="⬡"
                               FontSize="18"
                               Foreground="{DynamicResource FloatAccentBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Float"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Spacing="0">
                <Border Height="1"
                        Background="{DynamicResource SidebarBorderBrush}"
                        Margin="8,4"/>

                <!-- Engine status indicator -->
                <Border Margin="16,6,16,4">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Classes="status-dot"
                                 Classes.running="{Binding IsEngineRunning}"
                                 Width="7" Height="7"/>
                        <TextBlock Text="{Binding EngineStatusLabel}"
                                   FontSize="11"
                                   Foreground="{DynamicResource FloatSecondaryTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button Theme="{StaticResource NavItemTheme}"
                        Margin="8,0,8,12"
                        IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="⚙" FontSize="13"/>
                        <TextBlock Text="Settings" FontSize="13"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Margin="8,8,8,0" Spacing="2">

                <Button Theme="{StaticResource NavItemTheme}"
                        Classes.active="{Binding ShowingContainers}"
                        Command="{Binding ShowContainersCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="▦" FontSize="13"/>
                        <TextBlock Text="Containers" FontSize="13"/>
                    </StackPanel>
                </Button>

                <Button Theme="{StaticResource NavItemTheme}"
                        Classes.active="{Binding ShowingMigration}"
                        Command="{Binding ShowMigrationCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="⇒" FontSize="13"/>
                        <TextBlock Text="Migrate" FontSize="13"/>
                    </StackPanel>
                </Button>

                <Button Theme="{StaticResource NavItemTheme}" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="⬚" FontSize="13"/>
                        <TextBlock Text="Images" FontSize="13"/>
                    </StackPanel>
                </Button>

                <Button Theme="{StaticResource NavItemTheme}" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="◫" FontSize="13"/>
                        <TextBlock Text="Volumes" FontSize="13"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </DockPanel>

        <!-- ── Sidebar divider ───────────────────────────────────────── -->
        <Border DockPanel.Dock="Left"
                Width="1"
                IsVisible="{Binding !IsSetupMode}"
                Background="{DynamicResource SidebarBorderBrush}"/>

        <!-- ── Content area (fills remaining space) ──────────────────── -->
        <Border Background="{DynamicResource FloatWindowBackgroundBrush}">
            <ContentControl Content="{Binding CurrentPageViewModel}"/>
        </Border>

    </DockPanel>

</Window>
