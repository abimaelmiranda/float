<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Float.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Float.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Float"
        Icon="/Assets/float_icon.png"
        Width="1100" Height="700"
        MinWidth="900" MinHeight="600"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

    <!-- Window menus — appear after Float in the macOS menu bar -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="Containers">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="New Container…"       Command="{Binding NewContainerCommand}" Gesture="Ctrl+N"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Show Containers"      Command="{Binding ShowContainersCommand}"/>
                        <NativeMenuItem Header="Refresh"              Command="{Binding ShowContainersCommand}" Gesture="Ctrl+R"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Migrate from Docker…" Command="{Binding ShowMigrationCommand}"/>
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Images">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Show Images" Command="{Binding ShowImagesCommand}"/>
                        <NativeMenuItem Header="Refresh"     Command="{Binding ShowImagesCommand}"/>
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Volumes">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Create Volume…" Command="{Binding NewVolumeCommand}"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Show Volumes"   Command="{Binding ShowVolumesCommand}"/>
                        <NativeMenuItem Header="Refresh"        Command="{Binding ShowVolumesCommand}"/>
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <DockPanel>

        <!-- ── Sidebar (hidden in setup mode) ───────────────────────── -->
        <DockPanel DockPanel.Dock="Left"
                   Width="200"
                   IsVisible="{Binding !IsSetupMode}"
                   Background="{DynamicResource SidebarBackgroundBrush}">

            <Border DockPanel.Dock="Top"
                    Padding="16,52,16,8"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Image Width="20"
                           Height="20"
                           Source="/Assets/float_tray_light.png"
                           IsVisible="{Binding !IsDarkTheme}"/>
                    <Image Width="20"
                           Height="20"
                           Source="/Assets/float_tray_dark.png"
                           IsVisible="{Binding IsDarkTheme}"/>
                    <TextBlock Text="Float"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Spacing="0">
                <Border Height="1"
                        Background="{DynamicResource SidebarBorderBrush}"
                        Margin="8,4"/>

                <Button Theme="{StaticResource NavItemTheme}"
                        Margin="8,0,8,4"
                        Command="{Binding ToggleThemeCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Classes="icon icon-sm"
                              Data="{StaticResource IconSun}"
                              IsVisible="{Binding IsDarkTheme}"
                              Stroke="{Binding $parent[Button].Foreground}"/>
                        <Path Classes="icon icon-sm"
                              Data="{StaticResource IconMoon}"
                              IsVisible="{Binding !IsDarkTheme}"
                              Stroke="{Binding $parent[Button].Foreground}"/>
                        <TextBlock Text="{Binding ThemeToggleLabel}" FontSize="13"/>
                    </StackPanel>
                </Button>

                <Button Theme="{StaticResource NavItemTheme}"
                        Margin="8,0,8,12"
                        Classes.active="{Binding ShowingSettings}"
                        Command="{Binding ShowSettingsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Classes="icon icon-sm"
                              Data="{StaticResource IconSettings}"
                              Stroke="{Binding $parent[Button].Foreground}"/>
                        <TextBlock Text="Settings" FontSize="13"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Margin="8,8,8,0" Spacing="2">

                <Button Theme="{StaticResource NavItemTheme}"
                        Classes.active="{Binding ShowingContainers}"
                        Command="{Binding ShowContainersCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Classes="icon icon-sm"
                              Data="{StaticResource IconContainers}"
                              Stroke="{Binding $parent[Button].Foreground}"/>
                        <TextBlock Text="Containers" FontSize="13"/>
                    </StackPanel>
                </Button>

                <Button Theme="{StaticResource NavItemTheme}"
                        Classes.active="{Binding ShowingMigration}"
                        Command="{Binding ShowMigrationCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Classes="icon icon-sm"
                              Data="{StaticResource IconMigration}"
                              Stroke="{Binding $parent[Button].Foreground}"/>
                        <TextBlock Text="Migrate" FontSize="13"/>
                    </StackPanel>
                </Button>

                <Button Theme="{StaticResource NavItemTheme}"
                        Classes.active="{Binding ShowingImages}"
                        Command="{Binding ShowImagesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Classes="icon icon-sm"
                              Data="{StaticResource IconImages}"
                              Stroke="{Binding $parent[Button].Foreground}"/>
                        <TextBlock Text="Images" FontSize="13"/>
                    </StackPanel>
                </Button>

                <Button Theme="{StaticResource NavItemTheme}"
                        Classes.active="{Binding ShowingVolumes}"
                        Command="{Binding ShowVolumesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Classes="icon icon-sm"
                              Data="{StaticResource IconVolumes}"
                              Stroke="{Binding $parent[Button].Foreground}"/>
                        <TextBlock Text="Volumes" FontSize="13"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </DockPanel>

        <!-- ── Sidebar divider ───────────────────────────────────────── -->
        <Border DockPanel.Dock="Left"
                Width="1"
                IsVisible="{Binding !IsSetupMode}"
                Background="{DynamicResource SidebarBorderBrush}"/>

        <!-- ── Content area (fills remaining space) ──────────────────── -->
        <DockPanel Background="{DynamicResource FloatWindowBackgroundBrush}">

            <!-- Engine status is scoped to content, not the fixed sidebar. -->
            <Border DockPanel.Dock="Bottom"
                    Classes="engine-bottom-bar"
                    IsHitTestVisible="False">
                <Grid ColumnDefinitions="*,Auto,*">
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="7"
                                VerticalAlignment="Center">
                        <Ellipse Classes="status-dot bottom-bar-status-dot"
                                 Classes.running="{Binding IsEngineRunning}"
                                 Classes.starting="{Binding IsEngineStarting}"/>
                        <TextBlock Text="{Binding EngineStatusLabel}"
                                   Classes="bottom-bar-status-text"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <ContentControl Content="{Binding CurrentPageViewModel}"/>

                <Border IsVisible="{Binding IsNotificationVisible}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,18,0,0"
                        Padding="14,10"
                        CornerRadius="8"
                        MaxWidth="620"
                        Background="{DynamicResource FloatCardBackgroundBrush}"
                        BorderBrush="{DynamicResource SidebarBorderBrush}"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding NotificationTitle}"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding NotificationMessage}"
                                       FontSize="12"
                                       Foreground="{DynamicResource FloatSecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Theme="{StaticResource ActionButtonTheme}"
                                Command="{Binding HideNotificationCommand}"
                                VerticalAlignment="Center"
                                Padding="4"
                                ToolTip.Tip="Close">
                            <Path Classes="icon"
                                  Width="12"
                                  Height="12"
                                  Data="{StaticResource IconClose}"
                                  Stroke="{Binding $parent[Button].Foreground}"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>

    </DockPanel>

</Window>
