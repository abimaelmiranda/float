<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Float.UI.ViewModels"
             x:Name="Root"
             x:Class="Float.UI.Views.ImagesView"
             x:DataType="vm:ImagesViewModel">

    <Grid ColumnDefinitions="*,Auto">

        <DockPanel Grid.Column="0">
            <Border DockPanel.Dock="Top"
                    Padding="20,52,20,12">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Images"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Theme="{StaticResource PrimaryButtonTheme}"
                                Command="{Binding RefreshImagesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="icon icon-sm"
                                      Data="{StaticResource IconRefresh}"
                                      Stroke="White"/>
                                <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border IsVisible="{Binding HasError}"
                            Padding="10"
                            CornerRadius="6"
                            Background="{DynamicResource FloatCardBackgroundBrush}"
                            BorderBrush="{DynamicResource StatusErrorBrush}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource StatusErrorBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <ScrollViewer Padding="16,0,16,16">
                <ListBox Classes="container-list"
                         ItemsSource="{Binding Images}"
                         SelectedItem="{Binding SelectedImage}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ImageItemViewModel">
                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                    CornerRadius="8"
                                    Padding="14,10"
                                    Classes.selected="{Binding $parent[ListBoxItem].IsSelected}">
                                <Border.Styles>
                                    <Style Selector="Border.selected">
                                        <Setter Property="Background"
                                                Value="{DynamicResource SystemControlHighlightListAccentLowBrush}"/>
                                    </Style>
                                    <Style Selector="Border:pointerover">
                                        <Setter Property="Background"
                                                Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
                                    </Style>
                                </Border.Styles>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Tag}"
                                                   FontSize="13"
                                                   FontWeight="Medium"/>
                                        <TextBlock Text="{Binding PlatformLabel}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding IdShort}"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               VerticalAlignment="Center"
                                               Margin="16,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </DockPanel>

        <Border Grid.Column="1"
                Width="300"
                IsVisible="{Binding HasSelectedImage}"
                Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="1,0,0,0">
            <ContentControl Content="{Binding SelectedImage}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:ImageItemViewModel">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="16,52,16,12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Tag}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Theme="{StaticResource ActionButtonTheme}"
                                            Command="{Binding DataContext.CloseDetailCommand, ElementName=Root}"
                                            ToolTip.Tip="Close">
                                        <Path Classes="icon icon-sm"
                                              Data="{StaticResource IconClose}"
                                              Stroke="{Binding $parent[Button].Foreground}"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <ScrollViewer Padding="16,0,16,16">
                                <StackPanel Spacing="20">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="TAG"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   LetterSpacing="1"/>
                                        <TextBlock Text="{Binding Tag}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="NAME"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   LetterSpacing="1"/>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="ID"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   LetterSpacing="1"/>
                                        <TextBlock Text="{Binding IdShort}"
                                                   FontSize="13"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Id}"/>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="PLATFORM"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   LetterSpacing="1"/>
                                        <TextBlock Text="{Binding PlatformLabel}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>
    </Grid>
</UserControl>
